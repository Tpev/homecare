{
  "name": "@lolo-care/content-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Local STDIO MCP connector for the LoLo Care Content API",
  "type": "module",
  "bin": {
    "lolo-content-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "codex.config.example.toml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "tsc -p tsconfig.json --noEmit && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
