PORT=8088
PUBLIC_BASE_URL=https://voice.example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SMS_FROM=
TWILIO_VOICE_WEBHOOK_PATH=/twilio/voice
TWILIO_CALLBACK_WEBHOOK_PATH=/twilio/callback-discovery
TWILIO_STREAM_PATH=/ws/twilio
TWILIO_STREAM_AUTH_TOKEN=replace-me-before-production
DEEPGRAM_API_KEY=
DEEPGRAM_WS_URL=wss://agent.deepgram.com/v1/agent/converse
DEEPGRAM_LANGUAGE=en
DEEPGRAM_STT_MODEL=flux-general-en
DEEPGRAM_LLM_MODEL=gpt-4o-mini
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_GREETING="Thanks for calling Homecare. How can I help you today?"
DEEPGRAM_CALLBACK_GREETING="Hi, this is LoLo calling about your care request. Did I catch you at an okay time?"
DEEPGRAM_PROVIDER_OUTREACH_GREETING="Hi, this is Julie with LoLo Care. Who handles local resource options for families asking about non-medical help at home, like companionship, errands, meal prep, or respite?"
LARAVEL_BASE_URL=http://localhost
LARAVEL_INTERNAL_API_TOKEN=
PROMPT_FILE=prompts/system.md
VOICE_AGENT_CALLBACK_PROMPT_FILE=prompts/callback-discovery.md
VOICE_AGENT_PROVIDER_OUTREACH_PROMPT_FILE=prompts/provider-outreach.md
VOICE_AGENT_RECORDINGS_ENABLED=true
VOICE_AGENT_RECORDINGS_DIR=../storage/app/public/voice-agent-recordings
VOICE_AGENT_RECORDINGS_PUBLIC_BASE_URL=/storage/voice-agent-recordings
